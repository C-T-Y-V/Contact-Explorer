# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit LF for Kotlin source code, build scripts, and configs
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf

# Executable shell wrapper (must have LF for Linux/macOS runners)
gradlew text eol=lf

# Windows batch files must retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf

# Binary files (prevent any line ending mangling)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.aar binary
*.apk binary
*.aab binary
*.dex binary
*.keystore binary
*.jks binary
