<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="contact-explorer.db" />
        <exclude domain="database" path="contact-explorer.db-shm" />
        <exclude domain="database" path="contact-explorer.db-wal" />
        <exclude domain="sharedpref" path="explorer.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="contact-explorer.db-shm" />
        <exclude domain="database" path="contact-explorer.db-wal" />
    </device-transfer>
</data-extraction-rules>
